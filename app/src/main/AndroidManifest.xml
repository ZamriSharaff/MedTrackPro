<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MedTrackApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedTrackPro_Assignment3">
        <activity
            android:name=".ClinicianDashboardScreen"
            android:exported="false"
            android:label="@string/title_activity_clinician_dashboard_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".MedCoachScreen"
            android:exported="false"
            android:label="@string/title_activity_med_coach_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".ClinicianLoginScreen"
            android:exported="false"
            android:label="@string/title_activity_clinician_login_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".SettingsScreen"
            android:exported="false"
            android:label="@string/title_activity_settings_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".SignUpScreen"
            android:exported="false"
            android:label="@string/title_activity_sign_up_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".SymptomsScreen"
            android:exported="false"
            android:label="@string/title_activity_symptoms_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".AddMedicationScreen"
            android:exported="false"
            android:label="@string/title_activity_add_medication_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".HomeScreen"
            android:exported="false"
            android:label="@string/title_activity_home_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".LoginScreen"
            android:exported="false"
            android:label="@string/title_activity_login_screen"
            android:theme="@style/Theme.MedTrackPro_Assignment3" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MedTrackPro_Assignment3">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>